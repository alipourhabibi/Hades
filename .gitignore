# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# dev config
/config/dev.yaml
/config/example.com-key.pem
/config/example.com.pem
# buf.lock is a lockfile and belongs in the repository, like go.sum. It used to
# be ignored. `buf breaking --against <the main branch>` then resolved no deps
# on the against side, so every `import "buf/validate/validate.proto"` failed
# with "imported file does not exist" and the check could never run.
/hades

# runtime data (repos, generated SDKs, SQLite DB)
# Underscore-prefixed so the go tool does not treat generated SDK trees as
# packages of this module; see config.DiskStorageConfig.
/_data/
/data/
*.db
*.db-shm
*.db-wal

# Caddy auto-TLS data
/caddy_data/
/caddy_config/

